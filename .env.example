PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/circle
# During npm run dev the browser runs on 4200. For a local production build use http://localhost:3000.
APP_ORIGIN=http://localhost:4200
# Set production only behind HTTPS; it enables Secure cookies.
NODE_ENV=development
# Optional absolute path; otherwise server/uploads with npm start.
# UPLOAD_DIR=/absolute/path/to/uploads
# For calls across restrictive networks, configure a TURN relay you operate or subscribe to.
# Never put a TURN provider account/API secret here. Supply restricted, short-lived client ICE credentials.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
